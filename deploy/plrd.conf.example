# plrd configuration — `key = value`, `#` comments. Unknown keys are
# errors. Every value shown is the built-in default.

# Klipper API Unix socket (klippy's -a flag; Moonraker installs usually
# use /home/<user>/printer_data/comms/klippy.sock).
klipper_socket = /tmp/klippy_uds

# Where WAL segments, the heartbeat file, and the receive_seq sidecar
# live. Must be on storage that survives power loss with the printer.
wal_dir = /var/lib/plrd/wal

# Heartbeat file path override (default: <wal_dir>/heartbeat.bin).
#heartbeat_path = /var/lib/plrd/wal/heartbeat.bin

# Z steppers to record committed-step history for (dump_stepper). Add
# stepper_z1, stepper_z2, ... on multi-Z machines.
z_steppers = stepper_z

# Motion queues to record (dump_trapq).
trapq_queues = toolhead,extruder

# Heartbeat rewrite rate (Hz). Each rewrite is fdatasync'd.
heartbeat_hz = 10

# Batch fdatasync interval for motion records (ms). Markers and context
# snapshots are always synced immediately.
batch_sync_ms = 500

# Open the heartbeat file O_DSYNC instead of fdatasync per rewrite
# (same durability, one syscall instead of two).
heartbeat_o_dsync = false

# Rotate to a new WAL segment at this size (bytes).
segment_rotate_bytes = 16777216

# Bounded queue between the socket reader and the WAL thread. When the
# disk stalls and it fills, motion records are dropped and the gap is
# journaled as a SubscriptionGap marker.
channel_capacity = 1024

# Moonraker WebSocket endpoint, used for the boot-time pending-recovery
# announcement and by `plrd recover --execute`.
moonraker_url = ws://127.0.0.1:7125/websocket

# Control socket served by `plrd run` (UNIX stream socket; the Klipper
# plugin's PLR_STATUS / PLR_RECOVER commands connect here). The plugin
# reads the SAME path from the `control_socket` key of printer.cfg's
# [plr] section — the two must match; the install defaults keep them
# aligned, so change both together or neither. Mode 0666 by default
# (klippy runs as an unprivileged user the daemon cannot name; every
# mutating command is confirm- and gate-checked — see
# crates/plrd/src/ctrlsock.rs for the rationale and the group-based
# tightening story for multi-user hosts).
control_socket = /var/lib/plrd/plrd.sock

# ----------------------------------------------------------------------
# LEGACY machine snapshot ([machine]).
#
# PREFERRED SETUP: add a [plr] section to printer.cfg instead (see the
# klippy plugin's documentation). When the running Klipper config has a
# [plr] section, plrd sources the whole machine snapshot from the LIVE
# config at recover time (probe method, position_min, probe z_offset,
# force_move, attestations autosaved by PLR_SETUP, ...) and this
# [machine] section is IGNORED with an info note. The
# validated_config_hash blessing below is unnecessary in [plr] mode:
# the values are re-read from the running config on every run.
#
# Keep (or add) this section only for installs that have not adopted
# the plugin; everything below then behaves exactly as before.
#
# PROBE STEP — consensus touch vs. single PROBE. In [plr] mode the probe
# step is a consensus multi-touch (`PLR_TOUCH`): several accel-clamped
# touches with a retract between, a sliding-window best subset, and the
# median as the trigger Z — far more robust than one sample. Its
# tunables live in printer.cfg's [plr] section (NOT here), each with a
# hard band plrd re-validates:
#   touch_samples       agreeing samples for the median   [3, 7]   (3)
#   touch_sample_range  acceptable spread, mm             (0,0.015] (0.010)
#                       0.015 is a HARD cap — a wider band is REFUSED,
#                       never clamped (mirrors Cartographer's ceiling).
#   touch_retract       retract between/after touches, mm  >= 1.0   (2.0)
#   touch_accel         max_accel clamp around the touch   [50,1000](100)
# The plan also clamps max_accel to touch_accel with SET_VELOCITY_LIMIT
# before the touch and restores it after — and on any abort, so a failed
# recovery never leaves the printer at the touch accel.
# This LEGACY [machine] path predates the plugin, so `PLR_TOUCH` may not
# exist on the printer: it falls back to the stock single `PROBE
# SAMPLES=1` (no consensus, no accel clamp). Adopt [plr] for the
# consensus touch.
#
# RECOVERY-UX KEYS — these also live in printer.cfg's [plr] section (NOT
# here), each parsed tolerantly and re-validated by plrd against a hard
# band; an out-of-band value REFUSES recovery (never silently clamped).
#
# WHO CHECKS WHAT, for every [plr] key on this page. The plr Klipper
# plugin DECLARES each of them — it must, because klippy refuses to START
# on a config option no module reads, and builds the option map plrd
# reads from exactly those reads — but it checks only the type (and that
# a number is finite). It does not re-state the bands below. That is
# deliberate: plrd is the single authority on every band, so a bad value
# boots the printer and is refused later by plrd, naming the key and
# explaining the physics. Two components enforcing one limit is how you
# get a config that neither side will let you use.
# So: an out-of-band value here is a REFUSED RECOVERY, not a dead
# printer. The plugin reports the values it read for these keys in its
# klippy status object under `daemon_config` (an unset key reads null,
# meaning plrd's own default applies), so you can check what the daemon
# will see before you need it.
#   max_probe_nozzle_temp  hard ceiling for ANY contact op, C  [80,160] (150)
#                          Clamps the probe band to
#                          [probe_temp_min, min(probe_temp_max, this)];
#                          an empty clamped band is refused. The drag path
#                          has NO warm minimum — cold dragging is fine; a
#                          hot nozzle melts the part and corrupts the
#                          accelerometer readings — so it gates the
#                          ceiling only.
#
#                          THIS CEILING IS THE KLIPPY PLUGIN'S HARD
#                          REFUSAL POINT: the plugin rejects PLR_TOUCH /
#                          PLR_DRAG_PROBE when max(current, target)
#                          exceeds it. plrd therefore deliberately targets
#                          BELOW it (see THE PROBE TEMPERATURE below) and
#                          forgives measured overshoot by a small tolerance:
#                            commanded target  <= ceiling - 5 C (headroom)
#                            measured temp     <= ceiling + 2 C (tolerance,
#                              mirrors the plugin's
#                              MAX_TOUCH_TEMPERATURE_EPSILON)
#                            commanded target  <= ceiling (never forgiven)
#                          The asymmetry is intentional: PID overshoot
#                          around a legitimate target is absorbed;
#                          commanding a hotter nozzle is not.
#
#                          !! Setting max_probe_nozzle_temp too low WEDGES
#                          a recovery: the probe step runs after the Z frame
#                          is declared, so a temperature refusal there
#                          aborts with the frame unknown, blocks
#                          re-execution, and regenerates an identical plan
#                          that fails identically. plrd refuses such a
#                          config up front rather than letting it wedge:
#                          the band must be wide enough to hold the 5 C
#                          headroom below the ceiling, i.e.
#                          min(160, this) - 5 >= 140, so this >= 145.
#
#                          THE PROBE TEMPERATURE IS DERIVED, NOT
#                          CONFIGURED. There is no probe temperature key
#                          in [plr]: the nozzle temperature plrd COMMANDS
#                          for probing is
#                            min(150, min(160, max_probe_nozzle_temp) - 5)
#                          floored at 140 — the probing band [140, 160]
#                          and the 150 C target are built-in constants
#                          (PlanConfig / PROBE_TEMP_HEADROOM in
#                          crates/plr-recovery/src/build.rs), and the -5 is
#                          the headroom above. So with the defaults the
#                          plan sends M104 S145 under a 150 C ceiling, and
#                          max_probe_nozzle_temp is the ONE knob that moves
#                          it: lower the ceiling and the commanded target
#                          follows it down (145 C ceiling -> M104 S140);
#                          from 155 C up the target stops at 150.
#   pre_home_z_lift        Z lift added to the believed Z BEFORE XY homing,
#                          mm, so the homing moves clear the part  (0,20] (5)
#   reheat_park_x/y        nozzle park XY while reheating to print temps.
#                          OPTIONAL: when unset, each side of the part's
#                          bounding box (+10mm) is tried, clamped to the
#                          axis limits, and the first candidate VERIFIED to
#                          land outside the footprint is used; a plan
#                          warning recommends setting it explicitly. If no
#                          side stays clear (or a configured point sits
#                          inside the part), the plan says so explicitly
#                          instead of claiming a clearance it does not have.
#   reheat_park_delta_z    Z lift above the current Z when parking, mm
#                          (0,10] (2). plrd computes the ABSOLUTE target
#                          min(current_z + this, position_max) at execute
#                          time and commands that: Klipper does NOT clamp
#                          an out-of-range move, it raises "Move out of
#                          range" (kinematics/cartesian.py), which here
#                          would abort AFTER the probe established the Z
#                          reference and force a full re-run.
#   drag_nozzle_temp       nozzle temperature the ADXL DRAG path heats to
#                          AND HOLDS FOR before dragging, C.
#                          [0, ceiling - 5] (145)
#                          Default equals the touch path's commanded probe
#                          temp so both oracles reference at the same
#                          thermal state. Without it a drag could reference
#                          anywhere from ambient upward.
#                          *** 0 = OPT OUT: do not heat for the drag and do
#                          NOT wait. Use this for a deliberate cold drag —
#                          otherwise a cold-drag operator would be left
#                          waiting for the nozzle to cool to ambient, which
#                          it may never reach. At 0 the plan emits no M104,
#                          no M109 and no hold step at all; the contact
#                          ceiling still applies. ***
#                          *** FLOOR: a NONZERO value below 50 C is
#                          CONFIRMABLE, not refused. *** plrd explains the
#                          trap below and offers "continue anyway": on an
#                          open-frame machine in a cold room a 40 C target
#                          is perfectly reachable, and the worst case if
#                          it is not is a bounded wait ending in a CLEAN
#                          abort (the hold runs before the Z frame is
#                          declared), so this is your call to make, not
#                          ours to veto.
#                          THE CHAMBER-AMBIENT TRAP: a nonzero target makes
#                          the plan WAIT (M109), and on a PID hotend that
#                          includes waiting to COOL. On an enclosed or
#                          heated-chamber printer a 30-60 C target is at or
#                          below chamber ambient: the nozzle takes longer
#                          than the 15-minute step timeout to reach it, or
#                          NEVER reaches it — every retry burns the full
#                          timeout before aborting. If you want a cold
#                          drag, say 0 (no wait at all); do not approximate
#                          it with a low target.
#                          If the hold does time out, the abort is CLEAN:
#                          this step runs before the Z frame is declared,
#                          so no frame-invalid marker is written and you
#                          can simply retry after fixing the thermal issue.
#                          The hold is an M109, which Klipper blocks on. On
#                          a PID-controlled extruder M109 waits for the
#                          heater to SETTLE in BOTH directions, so a nozzle
#                          hotter than the target waits while it COOLS;
#                          with bang-bang control it only waits to heat.
#
#   *** KEEP THE PROBE/DRAG TEMPERATURE THE SAME BETWEEN CALIBRATION AND
#   RECOVERY. *** Run PLR_PROBE_TEST / PLR_NOISE_TEST at the same nozzle
#   temperature recovery will use. Nozzle thermal expansion shifts the
#   effective Z reference by tens of microns across a 100 C swing, so a
#   reference taken at one temperature and used at another carries a
#   systematic Z error — not noise you can average away.
#
# PURGE — exactly three coherent paths. Pick one; the precedence is:
#
#   1. purge_enable = False
#        No purge of any kind. Nothing is emitted.
#   2. purge_enable = True AND purge_macro set AND that macro exists
#        The MACRO owns the purge completely: its own positioning, amount
#        and speed. plr emits the call and nothing else, and does NOT
#        reposition the toolhead for it (a macro's motion is unknowable to
#        plr, exactly as with clean_nozzle_macro).
#   3. purge_enable = True AND purge_macro set BUT the macro is MISSING
#        plrd REFUSES to plan, naming the macro. It does NOT fall back to
#        the built-in purge: you asked for specific behavior, and quietly
#        extruding somewhere else instead is how filament ends up where
#        you never intended. (clean_nozzle_macro degrades to asking you to
#        confirm instead — that is safe because a human confirming a clean
#        tip is a real substitute. A purge has no such human fallback.)
#   4. purge_enable = True AND no purge_macro
#        The BUILT-IN purge, fully specified by the keys below.
#
#   purge_enable           purge before resuming (in the recovery file) (true)
#   purge_macro            OPTIONAL macro that OWNS the purge (path 2/3).
#                          If you have a wipe or a purge bucket, put it
#                          here — the macro can move to it, purge, and wipe.
#   purge_x, purge_y       OPTIONAL built-in purge location, mm.
#                          DEFAULT: the reheat park point (already
#                          computed part-clear and bounds-checked).
#   purge_z                OPTIONAL built-in purge ABSOLUTE Z, mm.
#                          DEFAULT: the elevated park Z already in effect.
#                          Set it to purge low over a defined spot instead
#                          of dropping filament from mid-air.
#                          *** FLOOR: purge_z MUST be >= 0. *** This is the
#                          only raw absolute Z you supply, and the recovery
#                          file runs in the TRUE frame where Z = 0 IS THE
#                          BED SURFACE. A negative value drives the nozzle
#                          into the bed at print temperature and extrudes
#                          into it, so plrd refuses it outright. Do NOT
#                          reason from stepper_z's position_min: that is
#                          deliberately BELOW the bed (typically -2) to give
#                          the probe envelope room, and is not a usable
#                          floor here.
#                          GUIDANCE: pick a height clear of the part. plrd
#                          warns if purge_z is below the resume Z (the top
#                          of what is already printed) — safe only if the
#                          purge point is over bare bed — and warns with a
#                          COLLISION RISK if the purge point is inside the
#                          part footprint AND purge_z is set, because the
#                          file descends to that Z over printed geometry.
#                          The descent runs at the slow entry feedrate.
#   purge_amount           built-in purge extrusion length, mm [0,100] (5)
#   purge_speed            built-in purge extrusion feedrate,
#                          mm/min (0,3000] (300)
#   purge_retract          filament retracted after the built-in purge to
#                          help break the string, mm [0,10] (0)
#
#   Every built-in purge coordinate is bounds-checked against the axis
#   limits before the plan is accepted, and plrd warns (does not refuse)
#   if the purge point lands inside the part's footprint — deliberate
#   sacrificial areas are legitimate, but you should see it stated.
#   clean_nozzle_macro     macro the clean-nozzle step calls when it exists
#                          (default CLEAN_NOZZLE). When NO such macro
#                          exists, that step emits no command and the plan
#                          asks the operator to confirm the nozzle is clean.
#
# ----------------------------------------------------------------------
# WHEN SOMETHING GOES WRONG: the three tiers
#
# Recovering a print after a power loss is a bad moment to meet a bare
# error string. Hours of machine time and a spool of filament are already
# committed. So every refusal, warning and failure in this system comes
# out as the same structured DIAGNOSIS — what happened, why it matters in
# physical terms, and the exact key or command to change — and every one
# of them carries a TIER that says what plrd does about it:
#
#   ADVISORY     Proceeds, and says so loudly. Nothing is being refused;
#                you are being told. (A temperature overshoot inside the
#                documented tolerance, an unverified park point, a resume
#                that did not land on infill.)
#
#   CONFIRMABLE  Stops, explains, and offers "continue anyway". (A
#                marginal contact zone, a stale calibration, a purge Z
#                below the top of the part, a drag temperature below the
#                floor, a reheat park point nobody could verify is clear
#                of the part.) Answering happens over the control socket —
#                the Klipper plugin's recovery prompts — so this is a
#                CLICK, made while looking at the explanation.
#
#                *** A CONFIRMABLE DIAGNOSIS ABORTS A NON-INTERACTIVE RUN.
#                *** Callers that never asked to be consulted (`on_confirm`
#                omitted or "abort" — which includes `plrd recover
#                --execute` on the CLI) get an abort rather than a
#                question. That is the intended fail-closed direction, but
#                it has a visible consequence: a machine with no
#                reheat_park_x/y configured AND no usable part geometry
#                now ABORTS a CLI recovery where it previously proceeded
#                with a warning. Configure reheat_park_x / reheat_park_y,
#                or run the recovery through the plugin so you can answer
#                the question.
#
#   HARD         Refuses. The only way past a Hard refusal is a pre-set
#                UNSAFE_-prefixed key below, edited in printer.cfg while
#                nothing is at stake. There is deliberately no runtime
#                button. (purge_z below the bed, a nozzle above the
#                contact ceiling, an unknown Z frame, an itinerary
#                outside the machine's limits.)
#
# The escape hatch differs between the two stopping tiers only in whether
# it is a click or a deliberate edit made while calm. That is the whole
# policy: the things you might reasonably wave through under pressure are
# Confirmable; the things you should only wave through with a clear head
# and a text editor are Hard.
#
# The line between them is "does the worst case damage something or leave
# the machine in a state nobody can vouch for?" A bounded wait that ends
# in a clean abort is NOT Hard, however annoying — you get the
# explanation and the button.
#
# ALMOST NO HARD REFUSAL HAS AN ESCAPE. Exactly ONE key exists, and it is
# spelled to be uncomfortable to type:
#
#   UNSAFE_allow_purge_z_below_bed        (false)
#                          Permits a negative purge_z — a nozzle driven
#                          into the bed at print temperature. That is the
#                          only refusal whose consequence is confined
#                          enough, and visible enough to you in advance,
#                          to be worth an escape hatch at all.
#
#                          TYPE IT EXACTLY AS SPELLED HERE, in the [plr]
#                          section of printer.cfg. Klipper's config parser
#                          lowercases option names, so the daemon receives
#                          it as unsafe_allow_purge_z_below_bed and
#                          accepts either spelling — the screaming prefix
#                          is for you, not for the parser.
#
#                          Nothing else needs doing: the plr Klipper
#                          plugin DECLARES this key (klippy refuses to
#                          START on a config option no module reads, and
#                          only publishes options a module actually read),
#                          and it deliberately does NOT judge the value —
#                          it checks that it parses as a boolean and
#                          passes it on. plrd stays the sole judge of what
#                          the override permits, so there is no second
#                          gate that can disagree with this one.
#
# Every OTHER Hard refusal — the machine prerequisites, a non-finite
# number, an unknown Z span, an out-of-bounds itinerary, a temperature
# the plugin's own ceiling gate would then refuse — has NO override, by
# design. Permitting those would mean commanding motion against a Z frame
# nobody can vouch for, or wedging the recovery after the frame is
# declared: the one state this system exists to avoid.
#
# When an UNSAFE_ key actually permits something, the plan says so out
# loud as an Advisory diagnosis. An override that fires silently is not
# an escape hatch, it is a booby trap for whoever is standing at the
# printer next.
#
# ----------------------------------------------------------------------
# THE Z-FRAME INTERLOCK — why a failed recovery blocks the next one
#
# The moment plrd issues the SET_KINEMATIC_POSITION that declares the
# shifted probing frame, Klipper's idea of Z is something plrd asserted
# rather than something anyone measured. If the recovery then stops for
# ANY reason before it re-establishes a trusted frame, Z is unknown — and
# driving the machine against an unknown Z is the one thing this design
# exists to prevent.
#
# So plrd writes a marker file (frame_invalid.json, in wal_dir)
# immediately BEFORE issuing that declare, and deletes it only when a
# recovery completes successfully. While it exists, --execute is refused;
# a fresh dry run regenerates the plan and clears it.
#
# Written on the way IN, not on the way out, deliberately: a marker
# written by the abort path is a code path that has to run, and a daemon
# restart, a SIGKILL, a crash or a second power cut are exactly the cases
# where it would not. Writing it first means it survives all of them
# without anything having to happen.
#
# And if that marker cannot be written, plrd does not declare the shifted
# frame at all — it refuses. A state we cannot record that we are in is a
# state we must not enter.
#
# BE CLEAR ABOUT WHAT THAT REFUSAL BUYS. It is narrow. By the time it
# fires, the earlier steps have already run: the idle timeout is extended,
# the Z steppers are energized, the CONSERVATIVE believed-Z frame has been
# declared and lifted from, XY is homed, and the heaters have been
# commanded (the nozzle may be sitting at probe temperature). What was
# avoided is the shifted probing frame and the probe itself — the point
# past which Z becomes a number nobody can re-derive. So the recovery is
# safe to retry once the write works, and NO fresh dry run is needed —
# but the printer is not parked, not cool, and will not shut itself down.
# Do not walk away from it.
#
# (In practice: if wal_dir is unwritable, fix that first. It is also where
# your transcript goes.)
#
# ----------------------------------------------------------------------
# CONFIRM-POINTS — pause and ask, instead of guessing (both default False)
#
#   confirm_z_before_resume    (false)
#                          After the true-Z declaration, lift to the entry
#                          standoff and PAUSE, reporting the Z plrd
#                          believes it is at and the arithmetic behind it,
#                          until you confirm over the control socket.
#                          Z was established by touching the part ONCE;
#                          everything after this trusts that number, and
#                          this is the last moment a human can compare it
#                          against the actual nozzle.
#                          The standoff lift reuses entry_hop through the
#                          same rail-clamped arithmetic the reheat park
#                          uses, so it CANNOT DESCEND — showing you where
#                          Z is by driving toward the bed would be exactly
#                          the unreviewed descent this design exists to
#                          eliminate.
#                          Declining (or letting it time out) aborts and
#                          invalidates the Z frame, because the pause sits
#                          after the shifted-frame declare: a fresh dry
#                          run is then required before any resume.
#   debug_confirm_each_step    (false)
#                          Pause before EVERY step, reporting that step's
#                          commands and verifications. A commissioning and
#                          diagnosis aid; it changes no command.
#
#   Both need an interactive caller. `plrd recover --execute` on the CLI
#   answers every confirm-point with "abort" (fail-closed), so enabling
#   either key and then running from the CLI aborts cleanly at the first
#   pause. Run the recovery through the Klipper plugin, which speaks the
#   control socket's confirm protocol.
#
#   confirm_timeout_s      (600) how long a pause waits for your answer
#                          before it gives up and aborts cleanly. Band
#                          [30, 3600] seconds; out-of-band REFUSES with a
#                          diagnosis rather than clamping.
#                          Raise it if you want time to walk to the
#                          machine and inspect a Z standoff with a
#                          flashlight; lower it for a headless or
#                          unattended setup where a pause nobody will
#                          answer should resolve quickly.
#                          Timing out is not a failure mode to avoid at
#                          all costs: it aborts cleanly, and abort is the
#                          safe direction. Frame invalidation is applied
#                          exactly as it would be for a decline at the
#                          same step, so a pause can never leave the Z
#                          frame ambiguous.
#
# ----------------------------------------------------------------------
# ACCELERATION during recovery — all OPTIONAL, all [50, 20000] mm/s^2
#
# Recovery moves happen next to printed geometry in a Z frame established
# by one contact measurement. If your machine's normal acceleration feels
# too brisk for that, slow the recovery down without touching your print
# profile. Absent means "leave the machine's own max_accel alone", which
# is the default posture. An out-of-band value is REFUSED with a
# diagnosis, never clamped.
#
#   recovery_accel         one max_accel for the WHOLE recovery. Recorded
#                          and restored on completion AND on abort (via
#                          the same cleanup mechanism that restores the
#                          touch clamp), so a failed recovery never leaves
#                          your printer at a recovery acceleration.
#   accel_home             the XY homing step.
#   accel_travel           the long XY travel to the contact point.
#   accel_probe            the contact step on the ADXL-drag and legacy
#                          single-PROBE paths. IGNORED on the consensus
#                          touch path, where touch_accel owns the contact
#                          acceleration — plrd says so with an Advisory
#                          diagnosis rather than letting two keys fight
#                          over the one motion that must not be
#                          over-driven.
#   accel_entry            the moves made close to printed geometry —
#                          INCLUDING the entry moves inside the generated
#                          recovery file, which are the ones that
#                          actually descend toward the part. It also
#                          covers the confirm_z_before_resume standoff
#                          and the lift-and-park before the reheat.
#                          Inside the recovery file the clamp is written
#                          as a literal pair (clamp before the entry
#                          block, restore after it), because that file has
#                          no runtime machinery. That needs your
#                          [printer] max_accel to name in the restore, so
#                          it works in [plr] mode; on the LEGACY [machine]
#                          path plrd cannot see the running config, skips
#                          the file-level clamp rather than leave one it
#                          could not undo, and says so in the plan.
#
#   Setting ANY of them makes the plan record the machine's own max_accel
#   first and put it back before the recovery file starts, so the resumed
#   print runs at your normal acceleration rather than a recovery
#   override. touch_accel (above) remains the probe-CONTACT value and is
#   unaffected.
#
#   KNOWN EDGE: "the machine's own max_accel" means the value in force
#   when the recovery began (and, inside the recovery file, [printer]
#   max_accel). If your sliced file had LOWERED acceleration with M204 or
#   SET_VELOCITY_LIMIT before the point you are resuming from, the
#   restore puts back the machine value, not the file's reduced one — so
#   the first moves after the resume can run faster than the same moves
#   did before the power loss, until the file's next M204. If that
#   matters for your part, add an M204 near the top of the print, or set
#   recovery_accel to the value your print actually uses.
#
# The recovery no longer seeks the original file with M26. It writes a
# generated <original>_RECOVERY.gcode into the virtual_sdcard root and
# selects it with M23/M24. That file reheats to print temperature, re-homes
# XY, travels BACK to a known destination (G28 discards the park position,
# and purging at the homed XY would leave a nozzle-attached string the
# entry moves drag over the print), purges, does the entry moves, then
# streams the original's verbatim tail. That destination is the built-in
# purge point when you set purge_x/purge_y, else the reheat park point.
# The park point is computed to clear the part; a purge point YOU set is
# only warned about, not moved, if it lands inside the part — structured so no part-directed move can
# precede the blocking M190/M109 heat waits (the heating gate). The tail is
# copied byte-for-byte, so non-UTF-8 slicer metadata and binary thumbnails
# survive intact. An existing file is never overwritten: the writer claims
# its name exclusively and picks <name>-2, -3, ... if it was taken.
#
# Recovery is REFUSED until every prerequisite validates; keys mirror
# plr-recovery's MachineConfig (see crates/plrd/src/config.rs for the
# full table). All attestations default to false: recovery must be
# consciously commissioned per machine.
[machine]
# [force_move] with enable_force_move: True is present in printer.cfg.
force_move_enabled = false
# Operator attestation: the Z leadscrews are self-locking (the bed
# cannot back-drive under gravity when the motors are off).
z_self_locking_attested = false
# Z steppers as `name` or `name:mcu` (bare names assume primary_mcu).
# Multi-MCU Z is refused by validation.
z_steppers = stepper_z
primary_mcu = mcu
# Probe: `tap` ([probe], nozzle-actuated) or `load_cell`
# ([load_cell_probe]), plus its configured z_offset in mm.
#probe_kind = tap
#probe_z_offset = -0.1
# Attestations that the probe's activate/deactivate gcode command no
# motion (empty gcode qualifies).
probe_activate_gcode_no_move = false
probe_deactivate_gcode_no_move = false
# The Z rail's position_min (or [printer] minimum_z_position), mm.
#z_position_min = -2.0
# printer.cfg location; plrd checksums it at recover time and compares
# against validated_config_hash (change detection). On mismatch the
# computed value is printed — re-validate the machine, then paste it
# here to re-bless.
#klipper_config_path = /home/pi/printer_data/config/printer.cfg
#validated_config_hash = crc32c:00000000
# [virtual_sdcard] path.
#virtual_sdcard_root = /home/pi/printer_data/gcodes
